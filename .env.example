# Copia este archivo a `.env` y rellena los valores. `.env` NUNCA se sube al
# repo (está en .gitignore) ni al VPS por git — se crea a mano en el servidor.
# Todas las variables llevan el prefijo TARDIC_ porque así las lee
# src/tardic/config.py (única fuente de verdad; nadie más lee os.environ).

# --- API ---

# Clave que debe mandar el cliente en el header `X-API-Key`. Genérala con:
#   openssl rand -hex 32
# No dejes el valor de ejemplo: config.py la rechaza si es "changeme",
# "cambiame", "secret" o "tardic" literal.
TARDIC_API_KEY=reemplaza-esto-con-openssl-rand-hex-32

# Tamaño máximo de subida en bytes. 1 GiB por defecto (~4 h de audio m4a).
TARDIC_MAX_UPLOAD_BYTES=1073741824

# Puerto que publica el contenedor `api` en el HOST. Ese VPS ya corre 25
# contenedores: revisa `docker ps` / `ss -ltnp` antes de asumir que 8080 está
# libre (ver docs/despliegue-vps.md, paso 2).
TARDIC_API_PORT=8080

# --- Base de datos ---

# El servicio `db` del compose crea el usuario y la base con estas credenciales
# al primer arranque, y api/worker se conectan componiendo la cadena a partir de
# ellas. La contraseña se escribe UNA sola vez: aquí.
TARDIC_DB_USER=tardic
TARDIC_DB_PASSWORD=reemplaza-esto-con-una-contrasena-fuerte
TARDIC_DB_NAME=tardic

# Solo para apuntar a una base EXTERNA (otro host, un pooler). Déjalo comentado
# para el uso normal con docker-compose: si lo defines, gana sobre lo de arriba
# y vuelves a tener la contraseña en dos lugares que hay que mantener iguales.
# TARDIC_DATABASE_URL=postgresql+psycopg://usuario:contrasena@host-externo:5432/tardic

# --- Almacenamiento ---

# Ruta DENTRO del contenedor donde vive audio + checkpoints. No la cambies a
# menos que también ajustes el volumen `audio-data` en docker-compose.yml.
TARDIC_DATA_DIR=/data

# --- Motor STT ---

TARDIC_STT_MODEL=large-v3-turbo
TARDIC_STT_COMPUTE_TYPE=int8
TARDIC_STT_LANGUAGE=es

# 0 = usa todos los núcleos físicos que el proceso vea. En el worker eso ya
# está limitado por TARDIC_WORKER_CPUS (ver abajo) vía cpuset/cpus del
# contenedor, así que dejarlo en 0 es seguro.
TARDIC_STT_THREADS=0

TARDIC_CHUNK_MINUTES=15.0
TARDIC_VAD=true

# --- Worker ---

TARDIC_POLL_INTERVAL_SECONDS=5.0
TARDIC_MAX_ATTEMPTS=3
TARDIC_JOB_TIMEOUT_SECONDS=28800

# Cuánto puede estar un trabajo sin dar señales de vida antes de darlo por
# abandonado y devolverlo a la cola. NO es lo mismo que JOB_TIMEOUT: aquel es el
# tope de duración de un trabajo. El worker renueva la señal al terminar cada
# trozo (~15 min), así que media hora deja margen de sobra. Si el worker muere y
# vuelve, recupera sus propios trabajos al instante sin esperar esto.
TARDIC_LEASE_TIMEOUT_SECONDS=1800

# Al terminar bien se borran el WAV convertido (~345 MB por cada 3 h de audio) y
# los puntos de guardado por trozo; el audio original y el TXT se conservan
# siempre. Ponlo en true solo para depurar: el disco se llena rápido.
TARDIC_KEEP_INTERMEDIATE_FILES=false

# Núcleos de CPU que el contenedor `worker` puede usar (equivalente a
# `docker run --cpus`). CONSERVADOR POR DEFECTO: 1.0 núcleo. Ese VPS corre 25
# contenedores de producción (otros servicios); un worker de
# Whisper sin límite se come todos los núcleos disponibles durante horas por
# cada audio largo y puede tumbar producción.
#
# Cómo subirlo con seguridad: mide con `nproc` y `uptime` en el VPS
# (docs/despliegue-vps.md, paso 1) y deja SIEMPRE al menos 1-2 núcleos libres
# para los 25 contenedores existentes. Ejemplos:
#   - VPS de 4 núcleos, carga baja  -> TARDIC_WORKER_CPUS=2
#   - VPS de 8 núcleos, carga baja  -> TARDIC_WORKER_CPUS=4-5
#   - No se sabe todavía            -> déjalo en 1.0 y ajusta después
TARDIC_WORKER_CPUS=1.0

# Límite de memoria del contenedor worker (formato de docker-compose:
# "2g", "1500m"...). faster-whisper con large-v3-turbo en int8 más el
# chunking miden ~1.5-2 GB medidos en el benchmark del 25/08; se deja
# holgado a 2 GB para no golpear el OOM killer a media transcripción.
TARDIC_WORKER_MEM_LIMIT=2g

# Prioridad de scheduling del proceso worker dentro de su contenedor (valor
# de `nice`, de -20 a 19). Positivo = el kernel prefiere SIEMPRE a los demás
# procesos del host (producción) sobre el worker cuando compiten por CPU.
TARDIC_WORKER_NICE=10
